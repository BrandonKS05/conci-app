NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site (share copy, optional absolute links). Local dev default:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# On Vercel: set NEXT_PUBLIC_APP_URL to your live https URL (e.g. https://app.vercel.app or custom domain).
# CRITICAL — Supabase Dashboard → Authentication → URL configuration (same project as NEXT_PUBLIC_SUPABASE_*):
# - Site URL must be your LIVE https origin (NOT http://localhost:3000) or OAuth returns users to localhost with ?code=.
# - Redirect URLs: add https://YOUR_DOMAIN/auth/callback and https://YOUR_DOMAIN/** (and *.vercel.app if needed).
NEXT_PUBLIC_SITE_HOST=conci.com

# Email reminders (Resend) — optional; host “nudge” from trip page (`trip-nudge-outbound`)
# RESEND_API_KEY: https://resend.com/api-keys
# NUDGE_EMAIL_FROM: verified sender domain, or onboarding@resend.dev for Resend’s test inbox
RESEND_API_KEY=
NUDGE_EMAIL_FROM=

# Legacy RapidAPI hotel browsing endpoint only. Not used for automatic lodging fallback or in-app checkout.
RAPIDAPI_KEY=

# LiteAPI (Nuitee) — primary lodging search, prebook, and in-app hotel checkout
LITEAPI_API_KEY=
# Optional commission margin on LiteAPI net rates, defaults to 10 and clamps 0–40
LITEAPI_MARGIN_PCT=

# Google Places API (New) — trip page live restaurants Text Search (`places:searchText`) + experiences. Enable Places API on the key’s GCP project.
GOOGLE_PLACES_API_KEY=

# SerpAPI: Google Flights inspiration rows + Google Maps place previews (TripParser chat when user names a venue)
# Google Flights rows are discovery-only; bookable in-app flight search uses Duffel.
SERPAPI_KEY=

# Duffel — in-app lodging & flight booking (https://app.duffel.com/join)
# DUFFEL_ACCESS_TOKEN: get from Duffel Dashboard → Apps → Access tokens
# Prefix with "duffel_test_" for sandbox (no real charges), "duffel_live_" for production.
# Without this, Conci uses mock/test mode (same code path, fake confirmation).
DUFFEL_ACCESS_TOKEN=

# Future affiliate/provider placeholders — inert until official integrations are implemented.
VIATOR_API_KEY=
GETYOURGUIDE_API_KEY=
OPENTABLE_API_KEY=

# Stripe (deposits / payments)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Subscription pricing (Stripe Dashboard → Products → recurring Prices — copy Price IDs)
STRIPE_PRICE_HOST=
STRIPE_PRICE_HOST_PRO=
