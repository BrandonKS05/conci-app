NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site (share copy, optional absolute links). Local dev default:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# On Vercel: set NEXT_PUBLIC_APP_URL to your live https URL (e.g. https://app.vercel.app or custom domain).
# If it stays localhost in Vercel env vars, some redirects can misbehave. Supabase Dashboard → Authentication → URL
# configuration: set Site URL to that same https URL and add Redirect URLs including https://YOUR_DOMAIN/auth/callback
NEXT_PUBLIC_SITE_HOST=conci.com

# Email reminders (Resend) — optional; host “nudge” from trip page
RESEND_API_KEY=
NUDGE_EMAIL_FROM=

# Trip page live data — same RAPIDAPI_KEY for all RapidAPI products below
RAPIDAPI_KEY=

# OpenTable Data API (elis-lab) — defaults shown; set only to override X-RapidAPI-Host / path from the playground
# RAPIDAPI_OPENTABLE_HOST=opentable-data-api.p.rapidapi.com
# RAPIDAPI_OPENTABLE_PATH=/restaurants

# Amadeus Tours & Activities (RapidAPI) — copy X-RapidAPI-Host from the playground
# RAPIDAPI_AMADEUS_HOST=
# RAPIDAPI_AMADEUS_PATH=/v1/shopping/activities

# Optional: Musement or another activities product (same RAPIDAPI_KEY)
# RAPIDAPI_MUSEMENT_HOST=
# RAPIDAPI_MUSEMENT_PATH=/search
# RAPIDAPI_ACTIVITIES_HOST=
# RAPIDAPI_ACTIVITIES_PATH=/search

# Tripadvisor COM (Things4u / ntd119) — default path tries /attractions/search (see playground); override if needed
# RAPIDAPI_TRIPADVISOR_HOST=tripadvisor-com1.p.rapidapi.com
# RAPIDAPI_TRIPADVISOR_PATH=/attractions/search

# Optional backup for activities when Tripadvisor returns no rows (e.g. Travel Info API on RapidAPI)
# RAPIDAPI_TRAVEL_INFO_HOST=
# RAPIDAPI_TRAVEL_INFO_PATH=/search

SERPAPI_KEY=

# Stripe (deposits / payments)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
