NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site (share copy)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_HOST=conci.com

# Email reminders (Resend) — optional; host “nudge” from trip page
RESEND_API_KEY=
NUDGE_EMAIL_FROM=

# Trip page live data (optional — each section degrades gracefully if unset)
RAPIDAPI_KEY=
# Optional: RapidAPI host for an OpenTable-style restaurant product (same key as RAPIDAPI_KEY)
# RAPIDAPI_OPENTABLE_HOST=
# RAPIDAPI_OPENTABLE_PATH=/api/restaurants
# Amadeus Tours & Activities on RapidAPI — copy X-RapidAPI-Host from the API playground (same RAPIDAPI_KEY)
# RAPIDAPI_AMADEUS_HOST=
# RAPIDAPI_AMADEUS_PATH=/v1/shopping/activities
SERPAPI_KEY=

# Stripe (deposits / payments)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
