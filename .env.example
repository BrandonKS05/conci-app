NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site (share copy, optional absolute links). Local dev default:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# On Vercel: set NEXT_PUBLIC_APP_URL to your live https URL (e.g. https://app.vercel.app or custom domain).
# CRITICAL — Supabase Dashboard → Authentication → URL configuration (same project as NEXT_PUBLIC_SUPABASE_*):
# - Site URL must be your LIVE https origin (NOT http://localhost:3000) or OAuth returns users to localhost with ?code=.
# - Redirect URLs: add https://YOUR_DOMAIN/auth/callback and https://YOUR_DOMAIN/** (and *.vercel.app if needed).
NEXT_PUBLIC_SITE_HOST=conci.com

# Email reminders (Resend) — optional; host “nudge” from trip page
RESEND_API_KEY=
NUDGE_EMAIL_FROM=

# Trip page live data — same RAPIDAPI_KEY for all RapidAPI products below
RAPIDAPI_KEY=

# OpenTable Data API (elis-lab) — defaults shown; set only to override X-RapidAPI-Host / path from the playground
# RAPIDAPI_OPENTABLE_HOST=opentable-data-api.p.rapidapi.com
# RAPIDAPI_OPENTABLE_PATH=/restaurants

# Google Places API (New) — trip page “Top experiences” (Text Search). Enable Places API on the key’s GCP project.
GOOGLE_PLACES_API_KEY=

# SerpAPI: Google Flights (trip page) + Google Maps place previews (TripParser chat when user names a venue)
SERPAPI_KEY=

# Stripe (deposits / payments)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
